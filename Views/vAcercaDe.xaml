<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="emoreiraExamen.Views.vAcercaDe"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Fondo}" Title="Acerca de">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16" HorizontalOptions="Fill">
            <Label Text="ACERCA DE" Style="{StaticResource TituloGlobal}"
                   FontSize="24" TextColor="{StaticResource Morado}" />
            <Image Source="foto_estudiante.png" HeightRequest="185" Aspect="AspectFit" />
            <Label Text="Estudiante: Elvis Moreira" Style="{StaticResource EtiquetaGlobal}" FontSize="17" />
            <Label Text="Carrera: Ingeniería en Informática" Style="{StaticResource EtiquetaGlobal}" FontSize="17" />
            <Label Text="Paralelo: COMPLETAR PARALELO" Style="{StaticResource EtiquetaGlobal}" FontSize="17" />
            <Label Text="Evaluación 1 - Desarrollo para dispositivos Móviles"
                   Style="{StaticResource EtiquetaGlobal}" FontSize="14" />
            <Button Text="Volver al Login" Style="{StaticResource BotonGlobal}"
                    Clicked="Volver_Clicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
